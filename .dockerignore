# Exclude files unused by the image build
.git
.github
img
*.md
LICENSE
seccomp.json

# Exclude local tooling and build output
.idea
.vscode
**/*_test.go
*.exe
*.test
coverage.out

# Keep local credentials out of the build context
.env
.env.*
**/.env
**/.env.*
**/*.key
**/*.pem
secrets
**/secrets
*.log
coverage*.out
.gitleaksignore
